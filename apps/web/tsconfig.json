{
  "extends": "@fquiz/config-typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@fquiz/database": ["../../packages/database/src"],
      "@fquiz/models": ["../../packages/models/src"],
      "@fquiz/auth": ["../../packages/auth/src"],
      "@fquiz/ui": ["../../packages/ui/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}
