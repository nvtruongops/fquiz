{
  "id": "NO_MOCK_DATA",
  "enabled": true,
  "category": "CODE_QUALITY",
  "severity": "WARNING",
  "searchDirs": ["apps/web/app/api", "apps/web/lib/modules", "apps/admin/app/api", "packages"],
