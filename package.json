    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pino": "^7.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.3.0",
    "jest-junit": "^17.0.0",
    "jest-sonar": "^0.2.16",
    "postcss": "^8.5.10",
    "shadcn": "^4.17.0",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "~3.4.17",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
