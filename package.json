{
  "name": "quiz-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib hooks store",
    "verify:theme": "node .agents/scripts/verify.js --rule=THEME_GOVERNANCE",
    "scan": "npx fallow",
    "scan:codeql": "codeql database create .codeql-db --language=javascript-typescript --overwrite && codeql database analyze .codeql-db codeql/javascript-queries --format=sarif-latest --output=codeql-results.sarif",
    "codegraph:sync": "codegraph sync",
    "test": "jest",
    "push": "tsx scripts/autopush.ts",
    "benchmark:mobile": "tsx --env-file=.env.local scripts/benchmark-mobile-perf.ts",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:performance": "tsx --env-file=.env.local scripts/test-quiz-performance.ts",
    "test:mongodb": "tsx --env-file=.env.local scripts/test-mongodb-performance.ts",
    "check:dashboard": "tsx --env-file=.env.local scripts/check-dashboard.ts",
    "test:session-perf": "tsx --env-file=.env.local scripts/test-session-start-perf.ts",
    "test:answer-perf": "tsx --env-file=.env.local scripts/test-answer-perf.ts",
    "seed": "tsx --env-file=.env.local scripts/seed-users.ts",
    "seed:public-quizzes": "tsx --env-file=.env.local scripts/seed-public-quizzes.ts",
    "seed:language": "tsx --env-file=.env.local scripts/seed-language.ts",
    "seed:vocabulary": "tsx --env-file=.env.local scripts/seed-vocabulary.ts",
    "seed:topic": "tsx --env-file=.env.local scripts/seed-topic.ts",
    "seed:genre": "tsx --env-file=.env.local scripts/seed-genre.ts",
    "seed:learning": "npm run seed:language && npm run seed:topic && npm run seed:genre",
    "migrate:preserve-results": "tsx --env-file=.env.local scripts/migrate-preserve-completed-session-results.ts",
    "migrate:preserve-results:dry-run": "tsx --env-file=.env.local scripts/migrate-preserve-completed-session-results.ts --dry-run",
    "migrate:questions-to-ref": "tsx --env-file=.env.local scripts/migrate-embedded-questions-to-ref.ts",
    "migrate:questions-to-ref:dry-run": "tsx --env-file=.env.local scripts/migrate-embedded-questions-to-ref.ts --dry-run",
    "migrate:verify": "tsx --env-file=.env.local scripts/verify-migration.ts",
    "benchmark": "tsx --env-file=.env.local scripts/benchmark-question-load.ts",
    "audit:quiz-codes": "tsx --env-file=.env.local scripts/audit-quiz-course-code-duplicates.ts",
    "cleanup:quiz-codes": "tsx --env-file=.env.local scripts/audit-quiz-course-code-duplicates.ts --apply",
    "audit:answer-conflicts": "tsx --env-file=.env.local scripts/audit-answer-conflicts.ts",
    "reconcile:question-bank": "tsx --env-file=.env.local scripts/reconcile-question-bank.ts",
    "generate:explanations-mln131": "tsx --env-file=.env.local scripts/generate-mln131-explanations.ts",
    "generate:explanations-mln131:apply": "tsx --env-file=.env.local scripts/generate-mln131-explanations.ts --apply",
    "generate:explanations-mln122": "tsx --env-file=.env.local scripts/generate-course-explanations.ts --course=MLN122",
    "generate:explanations-mln122:apply": "tsx --env-file=.env.local scripts/generate-course-explanations.ts --course=MLN122 --apply"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
