{
  "name": "@fquiz/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "turbo build",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "start": "npm run start --workspace=apps/web",
    "start:web": "npm run start --workspace=apps/web",
    "start:admin": "npm run start --workspace=apps/admin",
    "lint": "turbo lint",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:admin": "npm run lint --workspace=apps/admin",
    "check-types": "turbo check-types",
    "verify:theme": "node .agents/scripts/verify.js --rule=THEME_GOVERNANCE",
    "scan": "npx fallow",
    "scan:codeql": "codeql database create .codeql-db --language=javascript-typescript --overwrite && codeql database analyze .codeql-db codeql/javascript-queries --format=sarif-latest --output=codeql-results.sarif",
    "codegraph:sync": "codegraph sync",
    "test": "jest --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "push": "tsx scripts/autopush.ts",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:performance": "tsx --env-file=.env.local scripts/test-quiz-performance.ts",
    "test:mongodb": "tsx --env-file=.env.local scripts/test-mongodb-performance.ts",
    "check:dashboard": "tsx --env-file=.env.local scripts/check-dashboard.ts",
    "test:session-perf": "tsx --env-file=.env.local scripts/test-session-start-perf.ts",
    "test:answer-perf": "tsx --env-file=.env.local scripts/test-answer-perf.ts",
    "seed": "tsx --env-file=.env.local scripts/seed-users.ts",
    "seed:public-quizzes": "tsx --env-file=.env.local scripts/seed-public-quizzes.ts",
    "migrate:preserve-results": "tsx --env-file=.env.local scripts/migrate-preserve-completed-session-results.ts",
    "migrate:preserve-results:dry-run": "tsx --env-file=.env.local scripts/migrate-preserve-completed-session-results.ts --dry-run",
    "audit:quiz-codes": "tsx --env-file=.env.local scripts/audit-quiz-course-code-duplicates.ts",
    "cleanup:quiz-codes": "tsx --env-file=.env.local scripts/audit-quiz-course-code-duplicates.ts --apply",
    "reconcile:question-bank": "tsx --env-file=.env.local scripts/reconcile-question-bank.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.96.2",
    "@types/nodemailer": "^8.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^14.2.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^4.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "mongoose": "^9.11.2",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pino": "^7.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-no-unsanitized": "^4.0.2",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "^4.6.0",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "jest-junit": "^17.0.0",
    "postcss": "^8.5.10",
    "shadcn": "^4.1.2",
    "tailwindcss": "~3.4.17",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "braces": "^3.0.3"
  }
}
