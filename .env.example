# ==========================================
# 1. DATABASE & AUTHENTICATION (Mandatory)
# ==========================================
# Connection string MongoDB (Atlas hoặc Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret key ký JWT (Tối thiểu 32 kí tự, khuyến nghị dùng chuỗi hash 64 hex)
JWT_SECRET=your-secret-key-here-min-32-chars

# Secret key cũ để xoay tua JWT (Không bắt buộc)
JWT_SECRET_PREV=your-previous-secret-key-here

# Pino Logger level: trace | debug | info | warn | error
LOG_LEVEL=info

# ==========================================
# 2. DOMAINS & CORS
# ==========================================
# Các domain hình ảnh được phép dùng trong next/image (ngăn cách bởi dấu phẩy)
ALLOWED_IMAGE_DOMAINS=images.unsplash.com,lh3.googleusercontent.com,fquiz-web.vercel.app

# Base URL phía Client (Để trống để tự động dùng cùng origin)
# NEXT_PUBLIC_API_BASE_URL=

# URL của hệ thống (Dùng cho Email links, Callback, SEO)
APP_URL=http://localhost:3000

# CORS Allowed Origins trong proxy.ts (ngăn cách bởi dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://fquiz-web.vercel.app

# URL của Portal Quản trị (Dành cho link chuyển hướng và liên kết)
NEXT_PUBLIC_ADMIN_URL=https://fquiz-admin.vercel.app/login

# Domain của Auth Cookie (Không bắt buộc)
# AUTH_COOKIE_DOMAIN=localhost

# ==========================================
# 3. AI PROVIDERS (Nội dung câu hỏi / Từ vựng)
# ==========================================
# API Key của Google Gemini (Ưu tiên dùng cho AI features)
GEMINI_API_KEY=your-gemini-api-key

# API Key và Endpoint của OpenAI / Custom Local Provider
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=AI

# ==========================================
# 4. EMAIL SERVICE (SMTP)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_APP_PASSWORD=your-gmail-app-password
MAIL_FROM="FQuiz <your-email@example.com>"

# ==========================================
# 5. SCHEDULED CRON JOBS
# ==========================================
# Secret key bảo vệ các API Cron Endpoint (VD: /api/jobs/cleanup-deleted-accounts)
CRON_SECRET=your-cron-secret-key

# ==========================================
# 6. SOCIAL AUTHENTICATION (Google OAuth)
# ==========================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# 7. FEATURE FLAGS & EXTRA SECURITY
# ==========================================
# Bật/tắt tính năng Import Quiz từ UI
NEXT_PUBLIC_ENABLE_QUIZ_IMPORT=true

# Custom key mã hóa dữ liệu nhạy cảm (Tùy chọn, mặc định dùng JWT_SECRET)
ENCRYPTION_KEY=

# Custom DNS Resolver cho MongoDB Atlas DNS Fallback (Tùy chọn, mặc định 8.8.8.8,1.1.1.1)
DNS_RESOLVERS=8.8.8.8,1.1.1.1
