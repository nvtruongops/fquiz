# ==========================================
# 1. DATABASE & AUTHENTICATION (Mandatory)
# ==========================================
# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Signing Secret (Minimum 32 characters, 64-hex hash recommended)
JWT_SECRET=your-secret-key-here-min-32-chars

# Previous JWT Secret for Key Rotation (Optional)
JWT_SECRET_PREV=your-previous-secret-key-here

# Pino Logger Level: trace | debug | info | warn | error
LOG_LEVEL=info

# ==========================================
# 2. DOMAINS & CORS
# ==========================================
# Allowed image domains for next/image (comma-separated)
ALLOWED_IMAGE_DOMAINS=images.unsplash.com,lh3.googleusercontent.com,fquiz-web.vercel.app

# Client-side API Base URL (Leave empty to use same origin)
# NEXT_PUBLIC_API_BASE_URL=

# Canonical App URL (Used for email links, callbacks, SEO)
APP_URL=http://localhost:3000

# CORS Allowed Origins in proxy.ts (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://fquiz-web.vercel.app

# Admin Portal URL (Used for redirection and portal links)
NEXT_PUBLIC_ADMIN_URL=https://fquiz-admin.vercel.app/login

# Auth Cookie Domain (Optional)
# AUTH_COOKIE_DOMAIN=localhost

# ==========================================
# 3. AI PROVIDERS (Question Generation & RAG)
# ==========================================
# Google Gemini API Key (Primary AI provider)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI / Custom Provider API Key and Endpoint
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=AI

# ==========================================
# 4. EMAIL SERVICE (SMTP)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_APP_PASSWORD=your-gmail-app-password
MAIL_FROM="FQuiz <your-email@example.com>"

# ==========================================
# 5. SCHEDULED CRON JOBS
# ==========================================
# Secret key protecting cron endpoints (e.g., /api/jobs/cleanup-deleted-accounts)
CRON_SECRET=your-cron-secret-key

# ==========================================
# 6. SOCIAL AUTHENTICATION (Google OAuth)
# ==========================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# 7. FEATURE FLAGS & SECURITY
# ==========================================
# Enable/disable quiz import from UI
NEXT_PUBLIC_ENABLE_QUIZ_IMPORT=true

# Custom encryption key for sensitive data (Optional, defaults to JWT_SECRET)
ENCRYPTION_KEY=

# Custom DNS Resolvers for MongoDB Atlas DNS Fallback (Optional, defaults to 8.8.8.8,1.1.1.1)
DNS_RESOLVERS=8.8.8.8,1.1.1.1
